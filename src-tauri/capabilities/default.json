{
  "identifier": "default",
  "description": "Базовые права для главного окна MirrorCam",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:default",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
